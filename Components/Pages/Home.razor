
@page "/"
@using Listing.Data
@implements IDisposable
@inject QueueService QueueService

<PageTitle>Multi-Queue Manager</PageTitle>

<div>
    <div class="header-bar ">
        <h1>Dear Advisors!</h1>
        <button class="btn-primary" @onclick="OpenAddStationModal">+ Add Station Card</button>
    </div>

    <!-- stations cards -->
    <div class="card-grid">
        @foreach (var station in stations)
        {
            <div class="station-card" >
                <div class="station-header">
                    <h2>@station.StationName</h2>
                    <button class="btn-close-card" @onclick="() => DeleteStation(station.Id)">✕</button>
                </div>

                <div class="queue-list">
                    @if (station.Queue.Any())
                    {
                        @for (int i = 0; i < station.Queue.Count; i++)
                        {
                            var person = station.Queue[i];
                            var isCurrentTurn = (i == 0); 

                            <div class="queue-item @(isCurrentTurn ? "active-turn" : "")">
                                <div class="person-info">
                                    <span class="ticket-badge">#@person.TicketNumber</span>
                                    <span class="person-name">@person.Name</span>
                                </div>
                                <button class="btn-remove-person" @onclick="() => RemovePersonFromQueue(person.Id)">✕</button>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="empty-queue-text">Line is empty</p>
                    }
                </div>

                <button class="btn-add-line" @onclick="() => OpenAddPersonModal(station)">+ Add Name to Line</button>

                
                @if (addPersonStationId == station.Id)
                {
                    <div class="modal-overlay">
                        <div class="modal-box">
                            <h3>Add to @station.StationName's Line</h3>
                            <input type="text"
                                   @bind="newPersonInput"
                                   @bind:event="oninput"
                                   placeholder="Enter person's name"
                                   autofocus />
                            <div class="modal-actions">
                                <button class="btn-primary" @onclick="() => AddPersonToStation(station)">Add</button>
                                <button class="btn-secondary" @onclick="CloseAddPersonModal">Cancel</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- new card creation -->
    @if (showAddStationModal)
    {
        <div class="modal-overlay">
            <div class="modal-box">
                <h3>Create New Card</h3>
                <input type="text" @bind="newStationNameInput" placeholder="Advisor's Name " autofocus />
                <div class="modal-actions">
                    <button class="btn-primary" @onclick="CreateStation">Create</button>
                    <button class="btn-secondary" @onclick="CloseAddStationModal">Cancel</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Station> stations = new List<Station>();
    private bool showAddStationModal = false;
    private string newStationNameInput = string.Empty;

    // Add-person modal is per browser, so it stays here instead of the database
    private int? addPersonStationId;
    private string newPersonInput = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        stations = await QueueService.GetStationsAsync();
        QueueService.Changed += OnQueueChanged;
    }

    // Called when any browser changes the data
    private Task OnQueueChanged() => InvokeAsync(async () =>
    {
        stations = await QueueService.GetStationsAsync();
        StateHasChanged();
    });

    public void Dispose() => QueueService.Changed -= OnQueueChanged;

    // --- Station Card Management ---
    private void OpenAddStationModal() => showAddStationModal = true;
    private void CloseAddStationModal()
    {
        showAddStationModal = false;
        newStationNameInput = string.Empty;
    }

    private async Task CreateStation()
    {
        if (!string.IsNullOrWhiteSpace(newStationNameInput))
        {
            await QueueService.AddStationAsync(newStationNameInput.Trim());
            CloseAddStationModal();
        }
    }

    private Task DeleteStation(int stationId) => QueueService.DeleteStationAsync(stationId);

    // --- Queue Management Inside Each Card ---
    private void OpenAddPersonModal(Station station)
    {
        addPersonStationId = station.Id;
        newPersonInput = string.Empty;
    }

    private void CloseAddPersonModal()
    {
        addPersonStationId = null;
        newPersonInput = string.Empty;
    }

    private async Task AddPersonToStation(Station station)
    {
        if (!string.IsNullOrWhiteSpace(newPersonInput))
        {
            await QueueService.AddPersonAsync(station.Id, newPersonInput.Trim());
            CloseAddPersonModal();
        }
    }

    private Task RemovePersonFromQueue(int personId) => QueueService.RemovePersonAsync(personId);
}
